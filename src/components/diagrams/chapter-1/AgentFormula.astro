---
// Agent = LLM + Context + Tools: three components inside the agent boundary; the environment sits outside.
---

<svg
	class="dg"
	viewBox="0 0 720 250"
	role="img"
	aria-labelledby="d-af-title d-af-desc"
	style="min-width: 630px"
>
	<title id="d-af-title">Agent = LLM + Context + Tools</title>
	<desc id="d-af-desc">
		Inside the agent boundary sit three components joined by plus signs: the LLM as reasoning engine, Context as the
		working set, and Tools as action interfaces. The Environment sits outside the boundary, and the agent interacts
		with it in both directions.
	</desc>
	<defs>
		<marker id="d-af-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
			<path d="M0,0 L10,5 L0,10 z" class="dg-arrowhead"></path>
		</marker>
	</defs>

	<g class="dg-container dg-neutral">
		<rect x="12" y="12" width="480" height="226" rx="14"></rect>
		<text x="28" y="44" class="dg-title">Agent boundary</text>
		<text x="172" y="145" text-anchor="middle" class="dg-title">+</text>
		<text x="332" y="145" text-anchor="middle" class="dg-title">+</text>
	</g>

	<g class="dg-node dg-model">
		<rect x="28" y="78" width="128" height="120" rx="10"></rect>
		<text x="92" y="116" text-anchor="middle" class="dg-accent" font-weight="700">LLM</text>
		<text x="92" y="148" text-anchor="middle" class="dg-sub">reasoning</text>
		<text x="92" y="172" text-anchor="middle" class="dg-sub">engine</text>
	</g>
	<g class="dg-node dg-context">
		<rect x="188" y="78" width="128" height="120" rx="10"></rect>
		<text x="252" y="116" text-anchor="middle" class="dg-accent" font-weight="700">Context</text>
		<text x="252" y="148" text-anchor="middle" class="dg-sub">working</text>
		<text x="252" y="172" text-anchor="middle" class="dg-sub">set</text>
	</g>
	<g class="dg-node dg-tools">
		<rect x="348" y="78" width="128" height="120" rx="10"></rect>
		<text x="412" y="116" text-anchor="middle" class="dg-accent" font-weight="700">Tools</text>
		<text x="412" y="148" text-anchor="middle" class="dg-sub">action</text>
		<text x="412" y="172" text-anchor="middle" class="dg-sub">interfaces</text>
	</g>

	<g class="dg-node dg-env">
		<rect x="580" y="78" width="128" height="120" rx="10"></rect>
		<text x="644" y="116" text-anchor="middle" class="dg-accent" font-weight="700">Environment</text>
		<text x="644" y="148" text-anchor="middle" class="dg-sub">outside the</text>
		<text x="644" y="172" text-anchor="middle" class="dg-sub">boundary</text>
	</g>

	<g class="dg-edge">
		<line x1="494" y1="150" x2="578" y2="150" marker-start="url(#d-af-arrow)" marker-end="url(#d-af-arrow)"></line>
		<text x="536" y="132" text-anchor="middle" class="dg-edge-label">interacts</text>
	</g>
</svg>
