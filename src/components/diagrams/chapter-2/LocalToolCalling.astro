---
// Experiment 2-1: an agent talks to a local server that turns API messages into tokens for Qwen3-0.6B; the output stream runs <think> → text → tool call (redraw of Fig 2-5).
---

<svg
	class="dg"
	viewBox="0 0 720 412"
	role="img"
	aria-labelledby="d2-ltc-title d2-ltc-desc"
	style="min-width: 630px"
>
	<title id="d2-ltc-title">Local LLM tool calling architecture</title>
	<desc id="d2-ltc-desc">
		The agent framework sends OpenAI-format API messages to a local server such as vLLM or Ollama, which converts them
		into the model's internal token format for Qwen3-0.6B. In this experiment the model's output tokens come in a fixed
		order: first reasoning inside think tags, then the text reply to the user, then the tool call request. The tool
		call can start executing as soon as its parameters are complete. The framework runs the tools and the results go
		back into the messages for the next request.
	</desc>
	<defs>
		<marker id="d2-ltc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
			<path d="M0,0 L10,5 L0,10 z" class="dg-arrowhead"></path>
		</marker>
	</defs>

	<text x="2" y="28" class="dg-title">Local LLM tool calling architecture</text>

	<g class="dg-node dg-harness">
		<rect x="44" y="52" width="190" height="84" rx="10"></rect>
		<text x="139" y="80" text-anchor="middle" class="dg-accent" font-weight="700">Agent framework</text>
		<text x="139" y="103" text-anchor="middle" class="dg-sub">OpenAI-format</text>
		<text x="139" y="124" text-anchor="middle" class="dg-sub">API messages</text>
	</g>
	<g class="dg-node dg-neutral">
		<rect x="272" y="52" width="190" height="84" rx="10"></rect>
		<text x="367" y="80" text-anchor="middle" font-weight="700">Local server</text>
		<text x="367" y="103" text-anchor="middle" class="dg-sub">vLLM or Ollama</text>
		<text x="367" y="124" text-anchor="middle" class="dg-sub">messages → tokens</text>
	</g>
	<g class="dg-node dg-model">
		<rect x="500" y="52" width="190" height="84" rx="10"></rect>
		<text x="595" y="80" text-anchor="middle" class="dg-accent" font-weight="700">Qwen3-0.6B</text>
		<text x="595" y="103" text-anchor="middle" class="dg-sub">local model</text>
		<text x="595" y="124" text-anchor="middle" class="dg-sub">0.6B parameters</text>
	</g>

	<g class="dg-container dg-neutral">
		<rect x="28" y="164" width="678" height="134" rx="12"></rect>
		<text x="44" y="190" font-weight="700">Qwen3 output stream, in a fixed order</text>
	</g>
	<g class="dg-node dg-model">
		<rect x="500" y="206" width="190" height="76" rx="8"></rect>
		<text x="595" y="236" text-anchor="middle" class="dg-accent dg-mono" font-weight="700">1. &lt;think&gt;</text>
		<text x="595" y="262" text-anchor="middle" class="dg-sub">internal reasoning</text>
	</g>
	<g class="dg-node dg-model">
		<rect x="272" y="206" width="190" height="76" rx="8"></rect>
		<text x="367" y="236" text-anchor="middle" class="dg-accent" font-weight="700">2. Text reply</text>
		<text x="367" y="262" text-anchor="middle" class="dg-sub">to the user</text>
	</g>
	<g class="dg-node dg-tools">
		<rect x="44" y="206" width="190" height="76" rx="8"></rect>
		<text x="139" y="236" text-anchor="middle" class="dg-accent" font-weight="700">3. Tool call</text>
		<text x="139" y="262" text-anchor="middle" class="dg-sub">can execute early</text>
	</g>

	<g class="dg-node dg-tools">
		<rect x="44" y="326" width="190" height="72" rx="8"></rect>
		<text x="139" y="354" text-anchor="middle" class="dg-accent" font-weight="700">Tools execute</text>
		<text x="139" y="380" text-anchor="middle" class="dg-sub">results → messages</text>
	</g>

	<g class="dg-edge">
		<line x1="234" y1="94" x2="270" y2="94" marker-end="url(#d2-ltc-arrow)"></line>
		<line x1="462" y1="94" x2="498" y2="94" marker-end="url(#d2-ltc-arrow)"></line>
		<line x1="595" y1="136" x2="595" y2="204" marker-end="url(#d2-ltc-arrow)"></line>
		<line x1="500" y1="244" x2="464" y2="244" marker-end="url(#d2-ltc-arrow)"></line>
		<line x1="272" y1="244" x2="236" y2="244" marker-end="url(#d2-ltc-arrow)"></line>
		<line x1="139" y1="282" x2="139" y2="324" marker-end="url(#d2-ltc-arrow)"></line>
		<path d="M44,362 H16 V94 H42" marker-end="url(#d2-ltc-arrow)"></path>
	</g>
</svg>
